# FoodBridge Backend Environment Variables
# Copy this file to .env and replace the values with your local settings.

# Django Security
# Generate a new secret key for production!
SECRET_KEY=your-secret-key-here-change-me

# Debug mode (True for local development, False for production)
DEBUG=True

# Allowed hosts (comma-separated, no spaces)
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (PostgreSQL + PostGIS)
DB_NAME=foodbridge
DB_USER=foodbridge_user
DB_PASSWORD=foodbridge_pass
DB_HOST=localhost
DB_PORT=5432

# CORS Settings (Frontend URLs)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# LLM APIs (Optional, used for AI features like intake parsing)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
